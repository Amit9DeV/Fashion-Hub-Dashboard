# ─────────────────────────────────────────────────────────────────────────────
# Fashion Hub Backend — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# MongoDB Atlas connection string (must be a replica set for transactions)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate a secure 64-character hex secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of your Next.js frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── WhatsApp (Optional) ───────────────────────────────────────────────────────
# Meta Cloud API token for WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=fashion_hub_invoice

# ── Platform (auto-set by Render) ─────────────────────────────────────────────
# RENDER=true
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
