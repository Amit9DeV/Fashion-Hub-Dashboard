# ─────────────────────────────────────────────────────────────────────────────
# Fashion Hub Frontend — Environment Variables
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Server-side only. The browser calls the same-origin Next.js API proxy.
BACKEND_API_URL=http://localhost:5000/api
# Production (Render): BACKEND_API_URL=https://fashion-hub-dashboard.onrender.com/api

# ── Auth Secret (must MATCH backend AUTH_SECRET exactly) ─────────────────────
# Generate a unique secret and use the same value in the backend environment.
# Never deploy with this value empty or reuse a sample secret from source control.
AUTH_SECRET=

# ── App URL (used for HTTPS detection) ───────────────────────────────────────
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
