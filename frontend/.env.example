# ─────────────────────────────────────────────────────────────────────────────
# Fashion Hub Frontend — Environment Variables
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Points to the Express backend. No trailing slash.
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production (Render):
# NEXT_PUBLIC_API_URL=https://fashion-hub-dashboard.onrender.com/api

# ── Auth Secret (must MATCH backend AUTH_SECRET exactly) ─────────────────────
# Used by Next.js Server Components to verify JWTs in SSR/RSC context.
AUTH_SECRET=3ca27860358833a371a5e73b10bb19be3906632fdbf403b0fdfd05821bcc0af6c2855886e1323139c102544c13ce09da

# ── App URL (used for HTTPS detection) ───────────────────────────────────────
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
